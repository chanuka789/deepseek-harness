{
	admin off
	auto_https off
}

:{$PORT} {
	basic_auth {
		{$DSH_USERNAME} {$DSH_PASSWORD_HASH}
	}

	handle / {
		reverse_proxy 127.0.0.1:3080 {
			@unauthorized status 401
			handle_response @unauthorized {
				root * {$DSH_SITE_ROOT}
				rewrite * /sign-in.html
				header Cache-Control no-store
				file_server
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3080
	}
}
